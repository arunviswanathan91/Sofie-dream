# Copy this to .env.local and fill in your values.
#
# IMPORTANT for release APK builds:
#   Gradle assembleRelease does not automatically pick up .env.local.
#   Use scripts/build-release.ps1 (Windows) or scripts/build-release.sh (Mac/Linux)
#   to load these variables before running Gradle.

# ─── Firebase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sofi-dream.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sofi-dream
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sofi-dream.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ─── Google Drive backup (OAuth) ───────────────────────────────────────────────
# Create a Web OAuth 2.0 client in Google Cloud Console.
# Add sofi-dream://auth as an authorised redirect URI.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_oauth_client_id_here

# ─── Microsoft OneDrive backup (OAuth) ─────────────────────────────────────────
# Register an app in Azure Portal (Personal accounts only).
# Add sofi-dream://auth as a public client redirect URI.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_azure_app_client_id_here
